---
import '@/styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FloatingWhatsApp from '@/components/FloatingWhatsApp.astro';
import { site } from '@/data/site';
import defaultOg from '@/assets/site/hero-ward.jpg';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const { title, description = site.description, image = defaultOg, noindex = false, jsonLd = [] } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | Hospital Furniture Manufacturer in Pune`;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;
const og = await getImage({ src: image, width: 1200, format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, Astro.site).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  '@id': new URL('/#business', Astro.site).href,
  name: site.name,
  description: site.description,
  url: Astro.site?.href,
  logo: new URL('/favicon.svg', Astro.site).href,
  image: ogUrl,
  email: site.email,
  telephone: site.phone.replace(/\s/g, ''),
  founder: site.owner,
  foundingDate: site.founded,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  areaServed: 'IN',
  sameAs: [site.social.instagram, site.social.facebook],
};
const schemas = [organization, ...jsonLd];
---

<!doctype html>
<html lang="en-IN" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0d2142" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only z-[100] rounded-md bg-navy-900 px-4 py-2 text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >Skip to content</a
    >
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <FloatingWhatsApp />
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
