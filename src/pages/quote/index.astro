---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import QuoteForm from '@/components/QuoteForm';
import { products } from '@/data/products';
import { site, whatsappLink } from '@/data/site';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [{ href: '/quote', label: 'Request a Quote' }];
const tips = [
  'Add each product and its quantity, or paste your list in the message.',
  'Mention the delivery city so we can include transport.',
  'For a full ward or new hospital, add the number of beds and the opening date.',
];
---

<Layout
  title="Request a Quote"
  description={`Request a quotation for hospital furniture from ${site.name}, Pune. Add products and quantities for single items or bulk orders for wards and new hospitals.`}
  jsonLd={[breadcrumbSchema(Astro.site, crumbs)]}
>
  <PageHero eyebrow="Single items and bulk orders" title="Request a quote" intro="Tell us what you need. We reply with pricing, finish options and lead time." crumbs={crumbs} />
  <section class="container-x py-8 sm:py-14">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,8fr)_minmax(0,4fr)] lg:gap-12">
      <div class="rounded-lg border border-ink-200 p-4 sm:p-8">
        <h2 class="sr-only">Quote request form</h2>
        <QuoteForm client:load products={products.map((p) => ({ slug: p.slug, code: p.code, name: p.name }))} whatsapp={site.whatsapp} email={site.email} />
      </div>
      <aside class="space-y-4">
        <div class="rounded-lg bg-ink-50 p-5 sm:p-6">
          <h2 class="text-lg font-semibold">Bulk and project orders</h2>
          <ul class="mt-3 space-y-2.5 text-[15px] text-ink-700">
            {tips.map((t) => <li class="flex gap-2.5"><Icon name="check" class="mt-1 size-4 shrink-0 text-teal-600" />{t}</li>)}
          </ul>
        </div>
        <div class="rounded-lg border border-ink-200 p-5 sm:p-6">
          <h2 class="text-lg font-semibold">Prefer to talk?</h2>
          <div class="mt-4 grid gap-2.5">
            <a href={whatsappLink()} target="_blank" rel="noopener" class="btn-whatsapp"><Icon name="whatsapp" class="size-5" /> {site.whatsappDisplay}</a>
            <a href={site.phoneHref} class="btn-line"><Icon name="phone" class="size-4" /> {site.phone}</a>
            <a href={`mailto:${site.email}`} class="mt-1 text-center text-sm break-all text-ink-600 hover:text-teal-700">{site.email}</a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Layout>
