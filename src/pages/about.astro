---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import QuoteBand from '@/components/QuoteBand.astro';
import { site } from '@/data/site';
import { categories } from '@/data/categories';
import { products } from '@/data/products';
import { breadcrumbSchema } from '@/lib/schema';
import office from '@/assets/site/office.jpg';
import ward from '@/assets/site/hero-ward.jpg';
import room from '@/assets/site/private-room.jpg';

const crumbs = [{ href: '/about', label: 'About' }];
const values = [
  { icon: 'factory', title: 'Manufacturer, not a reseller', text: 'Products are built in our own workshop in Kondhwa, Pune, so we control quality and can adapt designs.' },
  { icon: 'shield', title: 'Durable materials', text: 'Mild steel with powder coating, stainless steel tops and polymer bows chosen for daily cleaning and heavy use.' },
  { icon: 'wrench', title: 'Practical designs', text: 'Features that nurses and doctors actually use: collapsible railings, castors with brakes, drawers and footsteps.' },
  { icon: 'chat', title: 'Personal service', text: 'Talk directly to the people who make your furniture, on the phone, WhatsApp or at our workshop.' },
] as const;
const industries = [
  { icon: 'hospital', label: 'Multi-speciality hospitals' },
  { icon: 'heart', label: 'ICU & critical care units' },
  { icon: 'clipboard', label: 'Clinics & OPDs' },
  { icon: 'baby', label: 'Maternity & nursing homes' },
  { icon: 'flask', label: 'Diagnostic centres' },
  { icon: 'academic', label: 'Medical colleges' },
] as const;
---

<Layout
  title="About Us"
  description={`${site.name} is a hospital furniture manufacturer in Kondhwa, Pune, founded in ${site.founded} by ${site.owner}. We build ICU beds, ward beds, trolleys and ward furniture.`}
  jsonLd={[breadcrumbSchema(Astro.site, crumbs)]}
>
  <PageHero eyebrow="About us" title="Hospital furniture, made with care in Pune" crumbs={crumbs} />

  <section class="container-x py-16 sm:py-20">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="reveal">
        <p class="text-lg leading-relaxed text-slate-600">
          <strong class="text-navy-900">{site.name}</strong> designs and manufactures hospital furniture for healthcare
          facilities of every size. Founded in {site.founded} by {site.owner}, we started with hospital beds and have grown
          into a full range of {products.length}+ products across {categories.length} categories.
        </p>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">
          From motorised ICU beds and emergency recovery trolleys to bedside lockers and examination couches, every product
          is built to be sturdy, easy to clean and comfortable for patients and staff.
        </p>
        <dl class="mt-10 grid grid-cols-3 gap-4">
          <div class="rounded-2xl bg-navy-50 p-5"><dt class="text-xs text-slate-500">Founded</dt><dd class="mt-1 font-display text-2xl font-bold text-navy-900">{site.founded}</dd></div>
          <div class="rounded-2xl bg-navy-50 p-5"><dt class="text-xs text-slate-500">Products</dt><dd class="mt-1 font-display text-2xl font-bold text-navy-900">{products.length}+</dd></div>
          <div class="rounded-2xl bg-navy-50 p-5"><dt class="text-xs text-slate-500">Based in</dt><dd class="mt-1 font-display text-2xl font-bold text-navy-900">Pune</dd></div>
        </dl>
      </div>
      <div class="reveal grid grid-cols-2 gap-4" style="--delay:120ms">
        <Image src={ward} alt="Hospital ward with beds and bedside lockers" widths={[320, 480, 640]} sizes="(min-width: 1024px) 300px, 45vw" class="col-span-2 aspect-[16/9] w-full rounded-3xl object-cover" />
        <Image src={room} alt="Private patient room with hospital bed" widths={[240, 360, 480]} sizes="(min-width: 1024px) 280px, 45vw" class="aspect-square w-full rounded-3xl object-cover" />
        <Image src={office} alt={`${site.name} office in Pune`} widths={[240, 360, 480]} sizes="(min-width: 1024px) 280px, 45vw" class="aspect-square w-full rounded-3xl object-cover" />
      </div>
    </div>
  </section>

  <section class="bg-navy-50/60 py-16 sm:py-20">
    <div class="container-x">
      <SectionHeading eyebrow="Our strengths" title="What sets us apart" align="center" />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map((v, i) => (
            <div class="reveal rounded-3xl bg-white p-6 shadow-card" style={`--delay:${i * 80}ms`}>
              <span class="grid size-12 place-items-center rounded-2xl bg-teal-50 text-teal-600"><Icon name={v.icon} class="size-6" /></span>
              <h3 class="mt-5 text-lg font-semibold">{v.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-x py-16 sm:py-20">
    <SectionHeading eyebrow="Who we serve" title="Industries we work with" intro="We supply furniture for new projects, expansions and replacements across the healthcare sector." />
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        industries.map((x, i) => (
          <li class="reveal flex items-center gap-4 rounded-2xl border border-navy-100 p-5" style={`--delay:${(i % 3) * 70}ms`}>
            <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-navy-900 text-teal-300"><Icon name={x.icon} class="size-5" /></span>
            <span class="font-medium text-navy-900">{x.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <QuoteBand />
</Layout>
