---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import QuoteBand from '@/components/QuoteBand.astro';
import { industries } from '@/data/industries';
import { categoryBySlug } from '@/data/categories';
import { products } from '@/data/products';
import { site } from '@/data/site';
import { productImage } from '@/lib/images';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [{ href: '/industries', label: 'Industries' }];
const byCode = Object.fromEntries(products.map((p) => [p.code, p]));
---

<Layout
  title="Industries We Serve"
  description={`Hospital furniture from ${site.name}, Pune, for multi-speciality hospitals, ICUs, wards, clinics and OPDs, nursing homes, maternity units and emergency departments.`}
  jsonLd={[breadcrumbSchema(Astro.site, crumbs)]}
>
  <PageHero eyebrow="Industries we serve" title="Furniture for every department" intro="Find the ranges and typical products for your type of facility, then send one list for a combined quotation." crumbs={crumbs}>
    <nav aria-label="Jump to industry" class="no-scrollbar -mx-4 mt-6 flex gap-2 overflow-x-auto px-4 sm:mx-0 sm:flex-wrap sm:px-0">
      {industries.map((x) => <a href={`#${x.id}`} class="inline-flex min-h-10 shrink-0 items-center rounded-md border border-white/20 px-3.5 text-sm whitespace-nowrap text-white hover:bg-white/10">{x.name}</a>)}
    </nav>
  </PageHero>

  <div class="container-x divide-y divide-ink-200">
    {
      industries.map((x, i) => (
        <section id={x.id} class="scroll-mt-20 py-10 sm:py-14" aria-labelledby={`${x.id}-title`}>
          <div class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-12">
            <div>
              <div class="overflow-hidden rounded-lg">
                <Image src={x.image} alt="" widths={[400, 640, 900]} sizes="(min-width: 1024px) 480px, 92vw" class="aspect-[16/9] w-full object-cover" loading={i === 0 ? 'eager' : 'lazy'} />
              </div>
            </div>
            <div>
              <p class="flex items-center gap-2 font-mono text-[11px] text-ink-500"><Icon name={x.icon} class="size-4 text-teal-600" /> {String(i + 1).padStart(2, '0')}</p>
              <h2 id={`${x.id}-title`} class="mt-2 text-2xl font-bold sm:text-3xl">{x.name}</h2>
              <p class="mt-3 text-ink-600 sm:text-lg">{x.text}</p>
              <h3 class="label-mono mt-6">Ranges</h3>
              <ul class="mt-2 flex flex-wrap gap-2">
                {x.ranges.map((r) => <li><a href={`/products/category/${r}`} class="inline-flex min-h-10 items-center rounded-md border border-ink-200 px-3 text-sm font-medium hover:border-ink-900">{categoryBySlug[r].name}</a></li>)}
              </ul>
              <h3 class="label-mono mt-6">Typical products</h3>
              <ul class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-4">
                {
                  x.picks.map((c) => byCode[c]).filter(Boolean).map((p) => (
                    <li>
                      <a href={`/products/${p.slug}`} class="group block h-full rounded-md border border-ink-200 p-2 hover:border-ink-400">
                        <span class="tile block aspect-square overflow-hidden rounded-sm">
                          <Image src={productImage(p.images[0])} alt="" widths={[160, 240]} sizes="(min-width: 640px) 150px, 44vw" class="size-full object-contain p-2 mix-blend-multiply" />
                        </span>
                        <span class="mt-1.5 block font-mono text-[11px] text-ink-500">{p.code}</span>
                        <span class="line-clamp-2 text-[13px] leading-snug font-semibold text-ink-900">{p.name}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </section>
      ))
    }
  </div>
  <p class="container-x pb-4 text-xs text-ink-500">Room photos illustrate typical settings.</p>
  <QuoteBand />
</Layout>
