---
import type { GetStaticPaths } from 'astro';
import { getImage } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/Icon.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ProductCard from '@/components/ProductCard.astro';
import ProductGallery from '@/components/ProductGallery';
import RecentlyViewed from '@/components/RecentlyViewed';
import QuoteBand from '@/components/QuoteBand.astro';
import { products, type Product } from '@/data/products';
import { categoryBySlug } from '@/data/categories';
import { site, whatsappLink, productWhatsappText } from '@/data/site';
import { productImage } from '@/lib/images';
import { attributesOf } from '@/lib/attributes';
import { breadcrumbSchema } from '@/lib/schema';
import { recentItems } from '@/lib/recent';

export const getStaticPaths = (() => products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }))) satisfies GetStaticPaths;

const { product } = Astro.props as { product: Product };
const category = categoryBySlug[product.category];
const attrs = attributesOf(product);

const gallery = await Promise.all(
  product.images.map(async (name) => {
    const src = productImage(name);
    const [main, thumb, full] = await Promise.all([
      getImage({ src, widths: [400, 600, 800, 1000], format: 'webp' }),
      getImage({ src, width: 160, format: 'webp' }),
      getImage({ src, width: 1400, format: 'webp', quality: 82 }),
    ]);
    return {
      src: main.src,
      srcset: main.srcSet.attribute,
      thumb: thumb.src,
      full: full.src,
      width: Number(main.attributes.width ?? 1000),
      height: Number(main.attributes.height ?? 1000),
    };
  }),
);

// Same range first, then neighbours in the catalogue, so every page links onward.
const sameRange = products.filter((p) => p.category === product.category && p.slug !== product.slug);
const related = sameRange.slice(0, 4);
const recent = await recentItems();

const crumbs = [
  { href: '/products', label: 'Products' },
  { href: `/products/category/${category.slug}`, label: category.short },
  { href: `/products/${product.slug}`, label: product.code },
];
const specs = [
  { k: 'Catalogue code', v: product.code },
  { k: 'Range', v: category.name, href: `/products/category/${category.slug}` },
  attrs.operation && { k: 'Operation', v: attrs.operation },
  attrs.functions && { k: 'Positions', v: `${attrs.functions} function` },
  attrs.materials.length > 0 && { k: 'Materials', v: attrs.materials.join(', ') },
  { k: 'Mobility', v: attrs.mobile ? 'On castors / wheels' : 'Static' },
  { k: 'Sizes and finishes', v: 'Confirmed on quotation' },
  { k: 'Manufacturer', v: `${site.name}, Pune` },
].filter(Boolean) as { k: string; v: string; href?: string }[];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  sku: product.code,
  mpn: product.code,
  description: product.summary,
  category: category.name,
  image: gallery.map((g) => new URL(g.full, Astro.site).href),
  brand: { '@type': 'Brand', name: site.name },
  manufacturer: { '@id': new URL('/#business', Astro.site).href },
  additionalProperty: specs
    .filter((s) => !['Catalogue code', 'Manufacturer', 'Sizes and finishes', 'Range'].includes(s.k))
    .map((s) => ({ '@type': 'PropertyValue', name: s.k, value: s.v })),
};
const waText = productWhatsappText(product.name, product.code);
const quoteHref = `/quote?product=${product.slug}`;
---

<Layout
  title={`${product.name} (${product.code})`}
  description={`${product.summary} Made by ${site.name}, Pune. Request a quote.`}
  image={productImage(product.images[0])}
  jsonLd={[breadcrumbSchema(Astro.site, crumbs), productSchema]}
  action={{ quoteHref, whatsappText: waText }}
>
  <div class="container-x pt-4 sm:pt-8">
    <Breadcrumbs crumbs={crumbs} />
  </div>
  <section class="container-x pt-4 pb-12 sm:pt-6 sm:pb-16">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-14">
      <div class="lg:sticky lg:top-24 lg:self-start">
        <ProductGallery client:load images={gallery} alt={product.name} code={product.code} />
      </div>
      <div>
        <a href={`/products/category/${category.slug}`} class="label-mono !text-teal-700 hover:underline">{category.name}</a>
        <h1 class="mt-2 text-[1.75rem] leading-[1.1] font-bold sm:text-4xl">{product.name}</h1>
        <p class="mt-4 text-base text-ink-600 sm:text-lg">{product.summary}</p>

        <div class="mt-6 grid gap-2.5 sm:grid-cols-2">
          <a href={quoteHref} class="btn-primary">Request Quote for This Product</a>
          <a href={whatsappLink(waText)} target="_blank" rel="noopener" class="btn-whatsapp"><Icon name="whatsapp" class="size-5" /> Ask on WhatsApp</a>
        </div>
        <a href={site.phoneHref} class="mt-3 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-ink-800 hover:text-teal-700"><Icon name="phone" class="size-4" /> Or call {site.phone}</a>

        <h2 class="mt-8 text-lg font-semibold">Key features</h2>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2">
          {
            product.features.map((f) => (
              <li class="flex items-start gap-2.5 rounded-md border border-ink-200 px-3.5 py-3 text-[15px] text-ink-900">
                <Icon name="check" class="mt-0.5 size-4 shrink-0 text-teal-600" />
                {f}
              </li>
            ))
          }
        </ul>

        <h2 class="mt-8 text-lg font-semibold">Specifications</h2>
        <dl class="mt-3 overflow-hidden rounded-lg border border-ink-200 text-[15px]">
          {
            specs.map((s, i) => (
              <div class:list={['grid grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-4 px-4 py-3', i % 2 === 0 && 'bg-ink-50']}>
                <dt class="label-mono self-center">{s.k}</dt>
                <dd class="font-medium text-ink-900">{s.href ? <a href={s.href} class="text-teal-700 underline-offset-2 hover:underline">{s.v}</a> : s.v}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-3 text-sm text-ink-500">Exact dimensions, finish and accessories are confirmed with your quotation.</p>
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="border-t border-ink-200 bg-ink-50 py-12 sm:py-16" aria-labelledby="related-title">
        <div class="container-x">
          <div class="flex items-end justify-between gap-4">
            <h2 id="related-title" class="text-xl font-bold sm:text-2xl">More in {category.name}</h2>
            <a href={`/products/category/${category.slug}`} class="shrink-0 text-sm font-semibold text-teal-700 hover:underline">View all {sameRange.length + 1} →</a>
          </div>
          <ul class="mt-6 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
            {related.map((p) => <li><ProductCard product={p} /></li>)}
          </ul>
        </div>
      </section>
    )
  }
  <RecentlyViewed client:idle items={recent} current={product.slug} />
  <QuoteBand />
</Layout>
