---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/Icon.astro';
import HeroSlider from '@/components/HeroSlider.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProductCard from '@/components/ProductCard.astro';
import QuoteBand from '@/components/QuoteBand.astro';
import MapBlock from '@/components/MapBlock.astro';
import { categories } from '@/data/categories';
import { products } from '@/data/products';
import { industries } from '@/data/industries';
import { faqs } from '@/data/faqs';
import { site, whatsappLink } from '@/data/site';

const featured = products.filter((p) => p.featured).slice(0, 8);
const countIn = (slug: string) => products.filter((p) => p.category === slug).length;

const facts = [
  { k: 'Since', v: site.founded },
  { k: 'Catalogue', v: `${products.length} products` },
  { k: 'Ranges', v: String(categories.length) },
  { k: 'Workshop', v: 'Kondhwa, Pune' },
];

const strengths = [
  { icon: 'factory', title: 'Buy from the maker', text: 'Our furniture is built in our own workshop in Kondhwa, Pune, so you deal directly with the people who make it.' },
  { icon: 'shield', title: 'Materials you can clean', text: 'Powder-coated steel frames, stainless steel tops and polymer bows, as listed on each product page.' },
  { icon: 'clipboard', title: 'One quote for a full set-up', text: 'ICU beds, ward beds, trolleys, couches and ward furniture from one supplier, quoted together.' },
  { icon: 'chat', title: 'Talk to us on WhatsApp', text: 'Send catalogue codes and quantities on WhatsApp, phone or email and get a clear quotation.' },
] as const;

const steps = [
  { title: 'Pick products', text: 'Browse the catalogue and note the codes, such as M3 or M29.' },
  { title: 'Send your list', text: 'Use the quote form or WhatsApp with quantities and delivery city.' },
  { title: 'Get a quotation', text: 'We reply with pricing, finish options and lead time.' },
];
---

<Layout
  description={`${site.name} manufactures ICU beds, Fowler beds, examination couches, stretchers, OT trolleys and ward furniture in Kondhwa, Pune. Browse ${products.length} products and request a quote.`}
>
  <!-- Hero -->
  <section class="blueprint relative overflow-hidden bg-ink-950 text-white">
    <div class="container-x grid grid-cols-[minmax(0,1fr)] items-center gap-8 py-8 sm:py-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-14 lg:py-20">
      <div>
        <p class="eyebrow !text-teal-300 before:!bg-teal-300">Hospital furniture manufacturer · Pune</p>
        <h1 class="mt-4 text-[2.3rem] leading-[1.02] font-bold text-white sm:text-6xl lg:text-[4.1rem]">
          Beds, couches and trolleys, <span class="text-teal-300">built in our Pune workshop.</span>
        </h1>
        <p class="mt-5 max-w-xl text-base text-ink-200 sm:text-lg">
          ICU and ward beds, examination couches, stretchers, OT trolleys and ward furniture for hospitals, clinics and nursing homes. Quotes on request.
        </p>
        <div class="mt-7 grid gap-2.5 sm:flex">
          <a href="/products" class="btn-primary">Browse {products.length} products <Icon name="arrowRight" class="size-4" /></a>
          <a href="/quote" class="btn-ghost-light">Request a bulk quote</a>
        </div>
        <dl class="mt-9 hidden grid-cols-4 border-t border-white/10 pt-5 sm:grid">
          {facts.map((f) => <div><dt class="label-mono !text-ink-400">{f.k}</dt><dd class="mt-1 font-semibold text-white">{f.v}</dd></div>)}
        </dl>
      </div>
      <HeroSlider />
    </div>
  </section>

  <!-- Facts strip on phones -->
  <dl class="grid grid-cols-2 border-b border-ink-200 sm:hidden">
    {facts.map((f, i) => <div class:list={['px-4 py-3.5', i % 2 === 0 && 'border-r border-ink-200', i < 2 && 'border-b border-ink-200']}><dt class="label-mono !text-[10px]">{f.k}</dt><dd class="mt-0.5 font-semibold text-ink-900">{f.v}</dd></div>)}
  </dl>

  <!-- Ranges -->
  <section class="container-x py-14 sm:py-20" aria-labelledby="ranges">
    <div class="flex items-end justify-between gap-6">
      <SectionHeading id="ranges" eyebrow="Product ranges" title="Six ranges for every ward" />
      <a href="/products/category" class="hidden shrink-0 text-sm font-semibold text-teal-700 hover:underline sm:block">All ranges →</a>
    </div>
    <ol class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-ink-200 bg-ink-200 sm:mt-10 lg:grid-cols-3">
      {
        categories.map((c, i) => (
          <li class="reveal bg-white" style={`--delay:${(i % 3) * 70}ms`}>
            <a href={`/products/category/${c.slug}`} class="group relative flex h-full flex-col p-3 sm:p-5">
              <div class="flex items-start justify-between">
                <span class="font-mono text-[11px] text-ink-500">{String(i + 1).padStart(2, '0')}</span>
                <span class="font-mono text-[11px] text-ink-500">{countIn(c.slug)} items</span>
              </div>
              <div class="img-ph mx-auto my-2 aspect-[4/3] w-full sm:my-4">
                <Image src={c.image} alt="" widths={[200, 320, 440]} sizes="(min-width: 1024px) 360px, 44vw" class="size-full object-contain mix-blend-multiply transition duration-500 group-hover:scale-105" />
              </div>
              <h3 class="text-[15px] leading-snug font-semibold sm:text-lg">{c.name}</h3>
              <p class="mt-1 hidden text-sm text-ink-600 sm:line-clamp-2">{c.description}</p>
              <span class="mt-3 hidden items-center gap-1 text-sm font-semibold text-teal-700 sm:flex">View range <Icon name="arrowRight" class="size-4 transition group-hover:translate-x-1" /></span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Featured -->
  <section class="border-y border-ink-200 bg-ink-50 py-14 sm:py-20" aria-labelledby="featured">
    <div class="container-x">
      <div class="flex items-end justify-between gap-6">
        <SectionHeading id="featured" eyebrow="From the catalogue" title="Featured products" />
        <a href="/products" class="shrink-0 text-sm font-semibold text-teal-700 hover:underline">View all →</a>
      </div>
    </div>
    <ul class="no-scrollbar container-x mt-8 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-4 sm:grid sm:grid-cols-2 sm:gap-5 sm:overflow-visible lg:grid-cols-4">
      {featured.map((p) => <li class="w-[68%] shrink-0 snap-start sm:w-auto"><ProductCard product={p} sizes="(min-width: 1024px) 290px, (min-width: 640px) 45vw, 68vw" /></li>)}
    </ul>
  </section>

  <!-- Strengths -->
  <section class="container-x py-14 sm:py-20" aria-labelledby="why">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <div>
        <SectionHeading id="why" eyebrow="Why hospitals call us" title="Straight from the workshop floor" intro={`Founded in ${site.founded} by ${site.owner}, ${site.name} makes hospital furniture for facilities of every size.`} />
        <a href="/about" class="btn-line mt-6">About the company</a>
      </div>
      <ul class="grid gap-px overflow-hidden rounded-lg border border-ink-200 bg-ink-200 sm:grid-cols-2">
        {
          strengths.map((s, i) => (
            <li class="reveal bg-white p-5 sm:p-7" style={`--delay:${i * 70}ms`}>
              <Icon name={s.icon} class="size-7 text-teal-600" />
              <h3 class="mt-4 text-lg font-semibold">{s.title}</h3>
              <p class="mt-1.5 text-[15px] text-ink-600">{s.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Industries -->
  <section class="blueprint relative bg-ink-950 py-14 text-white sm:py-20" aria-labelledby="industries">
    <div class="container-x">
      <div class="flex items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class="eyebrow !text-teal-300 before:!bg-teal-300">Industries we serve</p>
          <h2 id="industries" class="mt-3 text-[1.75rem] leading-[1.1] font-bold text-white sm:text-4xl">Furniture for every department</h2>
        </div>
        <a href="/industries" class="hidden shrink-0 text-sm font-semibold text-teal-300 hover:underline sm:block">All industries →</a>
      </div>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          industries.map((x, i) => (
            <li class="reveal" style={`--delay:${(i % 3) * 70}ms`}>
              <a href={`/industries#${x.id}`} class="group flex h-full gap-4 rounded-lg border border-white/10 bg-white/[0.03] p-4 transition hover:border-teal-300/60 hover:bg-white/[0.06] sm:p-5">
                <span class="grid size-11 shrink-0 place-items-center rounded-md bg-teal-600/20 text-teal-300"><Icon name={x.icon} class="size-5" /></span>
                <span>
                  <span class="block font-semibold text-white">{x.name}</span>
                  <span class="mt-1 block text-sm text-ink-300">{x.text}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/industries" class="btn-ghost-light mt-6 w-full sm:hidden">All industries</a>
    </div>
  </section>

  <!-- How ordering works -->
  <section class="container-x py-14 sm:py-20" aria-labelledby="how">
    <SectionHeading id="how" eyebrow="How ordering works" title="Three steps to a quotation" />
    <ol class="mt-8 grid gap-3 sm:grid-cols-3 sm:gap-5">
      {
        steps.map((s, i) => (
          <li class="reveal rounded-lg border border-ink-200 p-5 sm:p-6" style={`--delay:${i * 80}ms`}>
            <span class="font-mono text-sm font-medium text-teal-700">Step {String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-2 text-lg font-semibold">{s.title}</h3>
            <p class="mt-1 text-[15px] text-ink-600">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <QuoteBand />

  <!-- Location -->
  <section class="container-x pb-14 sm:pb-20" aria-label="Location and contact">
    <MapBlock />
  </section>

  <!-- FAQ teaser + social -->
  <section class="border-t border-ink-200 bg-ink-50 py-14 sm:py-20">
    <div class="container-x grid gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-14">
      <div>
        <SectionHeading eyebrow="FAQ" title="Common questions" />
        <div class="mt-6 divide-y divide-ink-200 rounded-lg border border-ink-200 bg-white">
          {
            faqs.slice(0, 3).map((f) => (
              <details class="group px-4 sm:px-5">
                <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-3 font-semibold text-ink-900 [&::-webkit-details-marker]:hidden">
                  {f.q}
                  <Icon name="chevronDown" class="size-5 shrink-0 text-ink-500 transition group-open:rotate-180" />
                </summary>
                <p class="pb-4 text-[15px] text-ink-600">{f.a}</p>
              </details>
            ))
          }
        </div>
        <a href="/faq" class="mt-4 inline-block text-sm font-semibold text-teal-700 hover:underline">All questions →</a>
      </div>
      <div class="rounded-lg bg-ink-900 p-6 text-white sm:p-8">
        <Icon name="instagram" class="size-8 text-teal-300" />
        <h2 class="mt-4 text-2xl font-bold text-white">See new work on Instagram</h2>
        <p class="mt-2 text-ink-200">Follow {site.social.instagramHandle} for product photos and updates from the workshop.</p>
        <div class="mt-6 grid gap-2.5">
          <a href={site.social.instagram} target="_blank" rel="noopener" class="btn bg-white text-ink-900 hover:bg-ink-50"><Icon name="instagram" /> Follow on Instagram</a>
          <a href={site.social.facebook} target="_blank" rel="noopener" class="btn-ghost-light"><Icon name="facebook" /> Facebook</a>
          <a href={whatsappLink()} target="_blank" rel="noopener" class="btn-ghost-light"><Icon name="whatsapp" /> WhatsApp</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
