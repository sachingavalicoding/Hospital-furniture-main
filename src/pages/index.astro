---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProductCard from '@/components/ProductCard.astro';
import QuoteBand from '@/components/QuoteBand.astro';
import { categories } from '@/data/categories';
import { products } from '@/data/products';
import { site, whatsappLink } from '@/data/site';
import { faqs } from '@/data/faqs';
import hero from '@/assets/site/hero-ward.jpg';
import icuBed from '@/assets/products/M-3.jpg';
import icuRoom from '@/assets/site/icu.jpg';
import opdRoom from '@/assets/site/opd.jpg';
import wardRoom from '@/assets/site/general-ward.jpg';
import procedureRoom from '@/assets/site/procedure-room.jpg';

const featured = products.filter((p) => p.featured).slice(0, 8);
const countIn = (slug: string) => products.filter((p) => p.category === slug).length;

const strengths = [
  { icon: 'factory', title: 'Made in our Pune workshop', text: 'We build our own furniture, so you deal directly with the maker and get direct pricing.' },
  { icon: 'shield', title: 'Built for daily hospital use', text: 'Powder-coated steel, stainless steel tops and polymer bows that are easy to clean and last for years.' },
  { icon: 'clipboard', title: 'Complete project supply', text: 'Beds, trolleys, couches and ward furniture from a single supplier for new wards and full hospital set-ups.' },
  { icon: 'chat', title: 'Fast quotes on WhatsApp', text: 'Send product codes and quantities on WhatsApp or email and get a clear quotation quickly.' },
] as const;

const sectors = [
  { title: 'ICU & Critical Care', image: icuRoom, text: 'Motorised and manual ICU beds, crash carts, monitor and syringe pump stands.' },
  { title: 'OPD & Clinics', image: opdRoom, text: 'Examination couches, gynae tables, stools and dressing trolleys for consultation rooms.' },
  { title: 'General & Private Wards', image: wardRoom, text: 'Fowler and plain beds, bedside lockers, over-bed tables and privacy screens.' },
  { title: 'Operation Theatres', image: procedureRoom, text: 'Instrument, Mayo, laparoscopic and ECG trolleys plus scrub basin stands.' },
];

const steps = [
  { title: 'Choose products', text: 'Browse the catalogue and note the product codes you need, such as M3 or M42.' },
  { title: 'Send your requirement', text: 'Use the quote form or WhatsApp to share quantities, finishes and delivery location.' },
  { title: 'Get a quotation', text: 'We reply with pricing, lead time and delivery details for your order.' },
  { title: 'Manufacture & deliver', text: 'Your furniture is built, checked and dispatched to your facility.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout
  description="Shree Jagadamba Production manufactures ICU beds, Fowler beds, examination couches, stretchers, OT trolleys and bedside lockers in Pune. Get a quick quote on WhatsApp or email."
  jsonLd={[faqSchema]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-b from-navy-50/80 to-white">
    <div class="pointer-events-none absolute -top-40 -right-40 size-[36rem] rounded-full bg-teal-200/40 blur-3xl"></div>
    <div class="container-x relative grid items-center gap-12 pt-12 pb-16 sm:pt-16 lg:grid-cols-12 lg:gap-8 lg:pt-20 lg:pb-24">
      <div class="lg:col-span-6 xl:col-span-5">
        <p class="hero-in eyebrow" style="--d:0ms"><span class="h-px w-6 bg-teal-500"></span>Hospital furniture manufacturer</p>
        <h1 class="hero-in mt-4 text-4xl leading-[1.08] font-extrabold sm:text-5xl xl:text-6xl" style="--d:80ms">
          Hospital furniture built for <span class="text-teal-500">better patient care</span>
        </h1>
        <p class="hero-in mt-6 max-w-xl text-lg leading-relaxed text-slate-600" style="--d:160ms">
          ICU beds, ward beds, examination couches, stretchers and medical trolleys, manufactured in Pune for hospitals,
          clinics and nursing homes.
        </p>
        <div class="hero-in mt-8 flex flex-col gap-3 sm:flex-row" style="--d:240ms">
          <a href="/products" class="btn-navy !px-6 !py-3.5">Explore Products <Icon name="arrowRight" class="size-4" /></a>
          <a href="/contact#quote" class="btn-primary !px-6 !py-3.5">Request a Quote</a>
        </div>
        <div class="hero-in mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-slate-600" style="--d:320ms">
          <span class="flex items-center gap-2"><Icon name="check" class="size-4 text-teal-500" />{products.length}+ products</span>
          <span class="flex items-center gap-2"><Icon name="check" class="size-4 text-teal-500" />Direct from manufacturer</span>
          <a href={whatsappLink()} target="_blank" rel="noopener" class="flex items-center gap-2 font-medium text-whatsapp-dark hover:underline"><Icon name="whatsapp" class="size-4" />Quick WhatsApp quotes</a>
        </div>
      </div>
      <div class="relative lg:col-span-6 xl:col-span-7">
        <div class="hero-in relative overflow-hidden rounded-[2rem] shadow-lift" style="--d:120ms">
          <Image
            src={hero}
            alt="Hospital ward furnished with beds, bedside lockers and privacy curtains"
            widths={[480, 768, 1024, 1400]}
            sizes="(min-width: 1280px) 720px, (min-width: 1024px) 50vw, 100vw"
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/3] w-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-navy-950/40 via-transparent"></div>
        </div>
        <div class="hero-in float-card absolute -bottom-6 left-4 flex items-center gap-3 rounded-2xl bg-white p-3 pr-5 shadow-lift sm:left-8" style="--d:400ms">
          <Image src={icuBed} alt="" width={120} height={120} class="size-16 rounded-xl bg-navy-50 object-contain p-1 mix-blend-multiply" />
          <div>
            <p class="text-xs font-semibold text-teal-600">Featured · M3</p>
            <p class="text-sm font-semibold text-navy-900">Motorised ICU Bed</p>
          </div>
        </div>
        <div class="hero-in float-card absolute top-6 -right-2 hidden rounded-2xl bg-white/95 px-5 py-4 shadow-lift sm:block lg:-right-4" style="--d:480ms; --float-delay: 1.5s">
          <p class="font-display text-3xl font-extrabold text-navy-900">{categories.length}</p>
          <p class="text-xs font-medium text-slate-500">product ranges</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="container-x py-20 sm:py-24">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <SectionHeading eyebrow="Our ranges" title="Furniture for every department" intro="From critical care to OPD, choose from six ranges designed around how hospitals actually work." />
      <a href="/products" class="btn-outline reveal shrink-0">View all products <Icon name="arrowRight" class="size-4" /></a>
    </div>
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((c, i) => (
          <a
            href={`/products/category/${c.slug}`}
            class="reveal group relative flex items-center gap-5 overflow-hidden rounded-3xl border border-navy-100 bg-white p-5 shadow-card transition hover:-translate-y-1 hover:border-teal-200 hover:shadow-lift"
            style={`--delay:${(i % 3) * 80}ms`}
          >
            <div class="size-24 shrink-0 overflow-hidden rounded-2xl bg-navy-50/70">
              <Image src={c.image} alt="" width={200} height={200} class="size-full object-contain p-2 mix-blend-multiply transition duration-500 group-hover:scale-110" />
            </div>
            <div class="min-w-0">
              <h3 class="text-lg font-semibold">{c.name}</h3>
              <p class="mt-1 text-sm text-slate-500">{countIn(c.slug)} products</p>
              <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-teal-600">
                Browse <Icon name="arrowRight" class="size-4 transition group-hover:translate-x-1" />
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Featured -->
  <section class="bg-navy-50/60 py-20 sm:py-24">
    <div class="container-x">
      <SectionHeading eyebrow="Popular products" title="Most requested by hospitals" intro="A selection of our popular beds, trolleys and ward furniture. Ask for a quote on any item in one click." align="center" />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
      <div class="mt-12 text-center">
        <a href="/products" class="btn-navy !px-6 !py-3.5">See the full catalogue <Icon name="arrowRight" class="size-4" /></a>
      </div>
    </div>
  </section>

  <!-- Strengths -->
  <section class="container-x py-20 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeading eyebrow="Why Shree Jagadamba" title="A manufacturer you can rely on" intro={`Since ${site.founded}, we have been building hospital furniture in Kondhwa, Pune, with a simple focus: sturdy products, honest pricing and quick responses.`} />
        <div class="reveal mt-8 flex flex-wrap gap-3">
          <a href="/about" class="btn-outline">About us</a>
          <a href="/contact#quote" class="btn-primary">Talk to us</a>
        </div>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:col-span-7">
        {
          strengths.map((s, i) => (
            <div class="reveal rounded-3xl border border-navy-100 p-6" style={`--delay:${i * 80}ms`}>
              <span class="grid size-12 place-items-center rounded-2xl bg-teal-50 text-teal-600">
                <Icon name={s.icon} class="size-6" />
              </span>
              <h3 class="mt-5 text-lg font-semibold">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Industries served -->
  <section class="bg-navy-950 py-20 text-white sm:py-24">
    <div class="container-x">
      <div class="reveal max-w-2xl">
        <p class="eyebrow !text-teal-300"><span class="h-px w-6 bg-teal-300"></span>Industries we serve</p>
        <h2 id="sectors" class="mt-3 text-3xl font-bold !text-white sm:text-4xl">Equipping every corner of healthcare</h2>
        <p class="mt-4 text-navy-200 sm:text-lg">Multi-speciality hospitals, nursing homes, clinics, maternity homes, diagnostic centres and medical colleges.</p>
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          sectors.map((s, i) => (
            <article class="reveal group relative overflow-hidden rounded-3xl" style={`--delay:${i * 80}ms`}>
              <Image src={s.image} alt={`${s.title} furnished with hospital furniture`} widths={[360, 540, 720]} sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 92vw" class="aspect-[3/4] w-full object-cover transition duration-700 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/40 to-transparent" />
              <div class="absolute inset-x-0 bottom-0 p-6">
                <h3 class="text-xl font-semibold !text-white">{s.title}</h3>
                <p class="mt-2 text-sm text-navy-100">{s.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="container-x py-20 sm:py-24">
    <SectionHeading eyebrow="How ordering works" title="From enquiry to delivery in four steps" align="center" />
    <ol class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((s, i) => (
          <li class="reveal relative" style={`--delay:${i * 90}ms`}>
            <span class="font-display text-5xl font-extrabold text-navy-100">0{i + 1}</span>
            <h3 class="mt-2 text-lg font-semibold">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <QuoteBand />

  <!-- FAQ + Instagram -->
  <section class="container-x pb-20 sm:pb-24">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <SectionHeading eyebrow="FAQ" title="Questions buyers often ask" />
        <div class="mt-8 divide-y divide-navy-100 rounded-3xl border border-navy-100">
          {
            faqs.map((f) => (
              <details class="group reveal p-6 [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-display font-semibold text-navy-900">
                  {f.q}
                  <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-navy-50 text-navy-700 transition group-open:rotate-45">+</span>
                </summary>
                <p class="mt-3 text-sm leading-relaxed text-slate-600">{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
      <aside class="reveal lg:col-span-5">
        <div class="flex h-full flex-col justify-between rounded-3xl bg-gradient-to-br from-teal-500 to-navy-800 p-8 text-white">
          <div>
            <span class="grid size-12 place-items-center rounded-2xl bg-white/15"><Icon name="instagram" class="size-6" /></span>
            <h2 class="mt-6 text-2xl font-bold !text-white">See our latest work on Instagram</h2>
            <p class="mt-3 text-white/85">New products, installations and workshop updates from {site.social.instagramHandle}.</p>
          </div>
          <div class="mt-8 flex flex-col gap-3">
            <a href={site.social.instagram} target="_blank" rel="noopener" class="btn bg-white text-navy-900 hover:bg-navy-50">Follow on Instagram <Icon name="arrowRight" class="size-4" /></a>
            <a href={site.social.facebook} target="_blank" rel="noopener" class="btn border border-white/30 text-white hover:bg-white/10"><Icon name="facebook" class="size-5" />Facebook</a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .hero-in {
    animation: hero-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  .float-card {
    animation:
      hero-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) both,
      float 6s ease-in-out infinite;
    animation-delay: var(--d, 0ms), var(--float-delay, 1s);
  }
  @keyframes float {
    50% {
      transform: translateY(-8px);
    }
  }
</style>
