---
import Icon from './Icon.astro';
import { whatsappLink } from '@/data/site';
---

<a
  href={whatsappLink()}
  target="_blank"
  rel="noopener"
  aria-label="Chat with us on WhatsApp"
  class="group fixed right-4 bottom-4 z-40 flex items-center gap-2 rounded-full bg-whatsapp p-3.5 text-white shadow-lift transition hover:bg-whatsapp-dark sm:right-6 sm:bottom-6 sm:pr-5"
>
  <Icon name="whatsapp" class="size-7" />
  <span class="hidden text-sm font-semibold sm:inline">Chat on WhatsApp</span>
</a>
