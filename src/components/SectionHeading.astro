---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2';
}
const { eyebrow, title, intro, align = 'left', as: Tag = 'h2' } = Astro.props;
---

<div class:list={['reveal max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow"><span class="h-px w-6 bg-teal-500" />{eyebrow}</p>}
  <Tag class="mt-3 text-3xl font-bold sm:text-4xl">{title}</Tag>
  {intro && <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">{intro}</p>}
  <slot />
</div>
