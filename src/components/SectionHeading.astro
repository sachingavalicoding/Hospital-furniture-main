---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  id?: string;
}
const { eyebrow, title, intro, align = 'left', id } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center [&_.eyebrow]:justify-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id} class="mt-3 text-[1.75rem] leading-[1.1] font-bold sm:text-4xl">{title}</h2>
  {intro && <p class="mt-3 text-ink-600 sm:text-lg">{intro}</p>}
</div>
