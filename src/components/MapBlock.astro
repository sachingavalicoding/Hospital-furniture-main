---
import Icon from './Icon.astro';
import { site, addressLine, directionsUrl, mapsPlaceUrl, mapEmbedUrl, whatsappLink } from '@/data/site';
interface Props {
  heading?: string;
  headingLevel?: 'h2' | 'h3';
}
const { heading = 'Visit our workshop', headingLevel: H = 'h2' } = Astro.props;
---

<div class="grid overflow-hidden rounded-lg border border-ink-200 bg-white lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
  <div class="p-5 sm:p-8">
    <p class="eyebrow">Location</p>
    <H class="mt-3 text-2xl font-bold sm:text-3xl">{heading}</H>
    <address class="mt-5 space-y-4 text-[15px] not-italic">
      <p class="flex gap-3"><Icon name="pin" class="mt-0.5 size-5 shrink-0 text-teal-600" /><span>{site.name}<br />{addressLine}</span></p>
      <a href={site.phoneHref} class="flex gap-3 font-semibold text-ink-900 hover:text-teal-700"><Icon name="phone" class="size-5 shrink-0 text-teal-600" />{site.phone}</a>
      <a href={`mailto:${site.email}`} class="flex gap-3 break-all hover:text-teal-700"><Icon name="mail" class="size-5 shrink-0 text-teal-600" />{site.email}</a>
      {
        site.hours ? (
          <div class="flex gap-3"><Icon name="clock" class="mt-0.5 size-5 shrink-0 text-teal-600" /><ul>{site.hours.map((h) => <li>{h.days}: {h.open}–{h.close}</li>)}</ul></div>
        ) : (
          <p class="flex gap-3 text-ink-600"><Icon name="clock" class="mt-0.5 size-5 shrink-0 text-teal-600" />Please call or WhatsApp before visiting so we can arrange a time.</p>
        )
      }
    </address>
    <div class="mt-6 grid gap-2.5 sm:flex">
      <a href={directionsUrl} target="_blank" rel="noopener" class="btn-ink"><Icon name="directions" class="size-5" /> Get directions</a>
      <a href={whatsappLink(`Hello ${site.name}, I would like to visit your workshop. When can I come?`)} target="_blank" rel="noopener" class="btn-line"><Icon name="whatsapp" class="size-5 text-whatsapp-dark" /> Plan a visit</a>
    </div>
  </div>
  <div class="relative min-h-[260px] border-t border-ink-200 bg-ink-100 sm:min-h-[340px] lg:border-t-0 lg:border-l">
    <iframe
      src={mapEmbedUrl}
      title={`Map showing ${site.name}, ${site.address.city}`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="absolute inset-0 size-full border-0"></iframe>
    <noscript><a href={mapsPlaceUrl} class="absolute inset-0 grid place-items-center font-semibold">Open in Google Maps</a></noscript>
    <a href={mapsPlaceUrl} target="_blank" rel="noopener" class="absolute right-3 bottom-3 rounded-md bg-white px-3 py-2 text-xs font-semibold text-ink-900 shadow-tile">Open in Google Maps ↗</a>
  </div>
</div>
