---
import Breadcrumbs from './Breadcrumbs.astro';
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  crumbs: { href: string; label: string }[];
}
const { eyebrow, title, intro, crumbs } = Astro.props;
---

<section class="blueprint relative overflow-hidden bg-ink-950 text-white">
  <div class="container-x relative py-8 sm:py-12 lg:py-16">
    <Breadcrumbs crumbs={crumbs} light />
    <div class="mt-6 max-w-3xl sm:mt-8">
      {eyebrow && <p class="eyebrow !text-teal-300 before:!bg-teal-300">{eyebrow}</p>}
      <h1 class="mt-3 text-[2rem] leading-[1.05] font-bold text-white sm:text-5xl">{title}</h1>
      {intro && <p class="mt-4 max-w-2xl text-base text-ink-200 sm:text-lg">{intro}</p>}
      <slot />
    </div>
  </div>
</section>
