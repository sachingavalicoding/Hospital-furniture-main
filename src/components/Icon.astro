---
import { icons, filledIcons, type IconName } from '@/lib/icons';
interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className = 'size-5' } = Astro.props;
const filled = filledIcons.includes(name);
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"><path d={icons[name]}></path></svg>
