---
import Icon from './Icon.astro';
import { site, whatsappLink } from '@/data/site';
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Planning a new ward, ICU or clinic?',
  text = 'Share your requirement and quantities. We will reply with pricing, lead time and delivery details.',
} = Astro.props;
---

<section class="container-x my-20 sm:my-24">
  <div class="reveal relative overflow-hidden rounded-[2rem] bg-navy-900 px-6 py-12 sm:px-12 sm:py-16">
    <div class="pointer-events-none absolute -top-24 -right-24 size-80 rounded-full bg-teal-500/25 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-32 left-1/3 size-80 rounded-full bg-navy-500/30 blur-3xl"></div>
    <div class="relative flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-bold text-white sm:text-4xl">{title}</h2>
        <p class="mt-4 text-navy-100 sm:text-lg">{text}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:shrink-0">
        <a href="/contact#quote" class="btn-primary !px-6 !py-3.5">Request a Quote <Icon name="arrowRight" class="size-4" /></a>
        <a href={whatsappLink()} target="_blank" rel="noopener" class="btn-ghost-light !px-6 !py-3.5"><Icon name="whatsapp" class="size-5" />WhatsApp {site.whatsappDisplay}</a>
      </div>
    </div>
  </div>
</section>
