---
import Icon from './Icon.astro';
import { site, whatsappLink } from '@/data/site';

interface Props {
  /** Product pages pass their own quote link and WhatsApp text. */
  quoteHref?: string;
  whatsappText?: string;
}
const { quoteHref = '/quote', whatsappText } = Astro.props;
const wa = whatsappLink(whatsappText);
---

<!-- Mobile and tablet: sticky action bar -->
<div class="fixed inset-x-0 bottom-0 z-40 border-t border-ink-200 bg-white/95 pb-[env(safe-area-inset-bottom)] shadow-[0_-8px_24px_-16px_rgb(11_31_51/0.35)] lg:hidden" role="region" aria-label="Quick contact">
  <div class="mx-auto grid max-w-xl grid-cols-[1fr_1fr_1.35fr] gap-2 px-3 py-2">
    <a href={site.phoneHref} class="flex min-h-12 flex-col items-center justify-center rounded-md text-[12px] font-semibold text-ink-900 active:bg-ink-100">
      <Icon name="phone" class="size-5" />Call
    </a>
    <a href={wa} target="_blank" rel="noopener" class="flex min-h-12 flex-col items-center justify-center rounded-md text-[12px] font-semibold text-whatsapp-dark active:bg-ink-100">
      <Icon name="whatsapp" class="size-5" />WhatsApp
    </a>
    <a href={quoteHref} class="btn-primary !min-h-12 !px-3 text-[14px]">Get Quote</a>
  </div>
</div>

<!-- Desktop: floating WhatsApp -->
<a
  href={wa}
  target="_blank"
  rel="noopener"
  aria-label="Chat with us on WhatsApp"
  class="fixed right-6 bottom-6 z-40 hidden items-center gap-2 rounded-full bg-whatsapp py-3 pr-5 pl-3.5 font-semibold text-white shadow-pop transition hover:bg-whatsapp-dark lg:flex"
>
  <Icon name="whatsapp" class="size-6" /><span class="text-sm">WhatsApp</span>
</a>

<button
  type="button"
  data-to-top
  data-show="false"
  aria-label="Back to top"
  class="fixed right-3 bottom-[calc(4.75rem+env(safe-area-inset-bottom))] z-40 grid size-11 place-items-center rounded-md border border-ink-200 bg-white text-ink-900 shadow-tile transition data-[show=false]:pointer-events-none data-[show=false]:translate-y-2 data-[show=false]:opacity-0 lg:right-6 lg:bottom-24"
>
  <Icon name="arrowUp" class="size-4" />
</button>
