---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Product } from '@/data/products';
import { categoryBySlug } from '@/data/categories';
import { productImage } from '@/lib/images';
import { whatsappLink } from '@/data/site';

interface Props {
  product: Product;
  eager?: boolean;
}
const { product, eager = false } = Astro.props;
const href = `/products/${product.slug}`;
---

<article class="group relative flex flex-col overflow-hidden rounded-3xl border border-navy-100 bg-white shadow-card transition duration-300 hover:-translate-y-1 hover:shadow-lift">
  <a href={href} class="relative block aspect-square overflow-hidden bg-navy-50/50" tabindex="-1" aria-hidden="true">
    <Image
      src={productImage(product.images[0])}
      alt=""
      widths={[320, 480, 640]}
      sizes="(min-width: 1280px) 300px, (min-width: 640px) 45vw, 92vw"
      loading={eager ? 'eager' : 'lazy'}
      class="size-full object-contain p-6 mix-blend-multiply transition duration-500 group-hover:scale-105"
    />
    <span class="absolute top-4 left-4 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-navy-700 ring-1 ring-navy-100">{product.code}</span>
  </a>
  <div class="flex flex-1 flex-col p-5">
    <p class="text-xs font-semibold tracking-wider text-teal-600 uppercase">{categoryBySlug[product.category].short}</p>
    <h3 class="mt-1.5 text-base leading-snug font-semibold">
      <a href={href} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none">{product.name}</a>
    </h3>
    <ul class="mt-3 space-y-1.5 text-sm text-slate-600">
      {
        product.features.slice(0, 2).map((f) => (
          <li class="flex gap-2">
            <Icon name="check" class="mt-0.5 size-4 shrink-0 text-teal-500" />
            {f}
          </li>
        ))
      }
    </ul>
    <div class="relative z-10 mt-auto flex gap-2 pt-5">
      <a href={`/contact?product=${product.slug}#quote`} class="btn-navy flex-1 !px-4 !py-2.5 text-xs">Get Quote</a>
      <a
        href={whatsappLink(`Hello, I am interested in ${product.name} (${product.code}). Please share price and details.`)}
        target="_blank"
        rel="noopener"
        aria-label={`Ask about ${product.name} on WhatsApp`}
        class="btn-whatsapp !p-2.5"><Icon name="whatsapp" class="size-5" /></a
      >
    </div>
  </div>
</article>
