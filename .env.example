# Copy to .env for local builds, or set these in Netlify > Site configuration > Environment variables.
# Everything here is optional. Nothing secret belongs in PUBLIC_ variables: they are visible in the page.

# Public site URL used for canonical links, Open Graph and the sitemap
SITE_URL=https://shreejagadambaproduction.netlify.app

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Analytics is off when empty.
PUBLIC_GA_ID=

# Google Search Console HTML-tag verification token (content value only).
PUBLIC_GOOGLE_SITE_VERIFICATION=
